API_PORT=4001
PORT_MAIN_WEBSITE=3005
PORT_EVENTS_PORTAL=3006
PORT_INDUCTION_PORTAL=3007

HOST="127.0.0.1"
# Database connection string (Required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE


POSTGRES_USER=ic
POSTGRES_PASSWORD=postgress_password
POSTGRES_DB=ic
POSTGRES_PORT=5434

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"


# Better Auth Configuration (Required)
# Generate a secret using: npx auth secret
BETTER_AUTH_SECRET="your-super-secret-auth-string-must-be-32-chars-long"
BETTER_AUTH_URL="http://localhost:${API_PORT}/api/auth"

# API URL for Frontend (Required)
NEXT_PUBLIC_API_URL="http://localhost:${API_PORT}/api"

# CORS Origins for API (Optional, defaults to localhost:3000 and 7030)
CORS_ORIGIN="http://localhost:${PORT_MAIN_WEBSITE},http://localhost:${PORT_INDUCTION_PORTAL},http://localhost:${PORT_EVENTS_PORTAL}"

# Google OAuth Configuration (Required for Google Sign-in)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Allowed Google Domains for sign-in (Optional)
# e.g., "nitp.ac.in"
# GOOGLE_ALLOWED_DOMAINS="nitp.ac.in"

# WhatsApp / SMS Configuration (Required for phone sign-in)
AISENSY_API_KEY="your-aisensy-api-key"

# Super Admin Seed Details (Optional)
# Used when running Prisma seed to create the initial super admin
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="super-admin-user@fms.local"
SUPER_ADMIN_PASSWORD="Your_Password_123"

# Google Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"



MINIO_ROOT_USER=ic-minio-admin
MINIO_ROOT_PASSWORD=minio_password

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_BUCKET=ic-documents
MINIO_USE_SSL=false
MINIO_REGION=us-east-1


STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=ic-minio-admin
STORAGE_SECRET_KEY=minio_password
STORAGE_BUCKET=ic-documents
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
STORAGE_PROVIDER=minio

# Added for API Validation
JWT_SECRET="your-super-secret-jwt-key-must-be-32-chars-long"
GEMINI_API_KEY="your-gemini-api-key"
AWS_ACCESS_KEY_ID="ic-minio-admin"
AWS_SECRET_ACCESS_KEY="minio_password"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="ic-documents"

NODE_ENV="development"
